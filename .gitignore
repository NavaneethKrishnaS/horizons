# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts
horizons-stays-photo-sourcing.xlsx

# Raw photography sourced from properties — selected + compressed into public/images/stays
_source-photos/

# Files the Claude desktop app drops here when it delivers something
Claude outputs/

# Screenshots this session writes into public/ to look at pages
# through the dev server. Never part of the site.
public/__*

# A stale Turbopack dev cache, renamed out of the way so the dev server
# could start. Safe to delete from Finder; nothing in it is source.
/.next-stale-cache/

# The originals behind public/images/experiences/*.webp. Kept on disk so
# they can be re-cropped, kept out of the repository because only the
# webp is ever served and a 7MB jpeg in git history is there for good.
public/images/experiences/kayaking.jpg
public/images/experiences/shikara.PNG
public/images/experiences/ferryboat.jpg
